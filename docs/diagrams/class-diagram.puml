@startuml
skinparam classAttributeIconSize 0

class User {
  id: int
  username: str
  full_name: str
  password_hash: str
  created_at: datetime
}

class Letter {
  id: int
  subject: str
  body: text
  sender_id: int
  receiver_id: int
  is_read: bool
  created_at: datetime
}

class Attachment {
  id: int
  letter_id: int
  original_name: str
  saved_name: str
  content_type: str
  size_bytes: int
}

User "1" -- "0..*" Letter : sends
User "1" -- "0..*" Letter : receives
Letter "1" -- "0..1" Attachment : has
@enduml
